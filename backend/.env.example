# Copy to .env (never commit it). Everything is optional: with no keys the app runs in template mode.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
RATE_LIMIT=60/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_CAS=10/minute
RATE_LIMIT_CHAT=20/minute
MAX_UPLOAD_MB=10
DEFAULT_GROSS_RETURN=0.12
DEFAULT_RETIRE_AGE=60

# LLM fallback chain, tried in this order: Azure OpenAI -> Gemini -> Groq -> Mistral -> any OpenAI-compatible -> Ollama.
# Model names change often; set whatever is current on the provider's site.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional third provider (free 'Experiment' plan at console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Optional: which provider to try first, e.g. LLM_ORDER=groq,gemini
LLM_ORDER=
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=20
BREAKER_FAILURES=3
BREAKER_COOLDOWN_S=60
